# Shared Git configuration — keep personal identity in ~/.gitconfig.local
[include]
    path = ~/.gitconfig.local

[core]
    editor = vim
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    excludesfile = ~/.gitignore_global
    untrackedCache = true
    # Do not enable core.fsmonitor globally. The built-in daemon starts
    # once per repo and stalls git status (Starship's prompt) past the
    # command timeout. Enable it only in large working trees:
    #   git config core.fsmonitor true

[color]
    ui = auto

[diff]
    tool = vimdiff

[difftool]
    prompt = false

[color "branch"]
    current = green bold
    local = green
    remote = cyan

[color "diff"]
    meta = yellow bold
    frag = cyan
    old = red
    new = green bold
    whitespace = red reverse

[color "status"]
    added = green bold
    changed = yellow
    untracked = cyan

[gitflow "prefix"]
    versiontag = v

[alias]
    lg = log --color --graph --pretty=format:'%C(green)%h%Creset -%C(yellow)%d%Creset %s %C(cyan)(%cr) %C(bold green)<%an>%Creset' --abbrev-commit

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
