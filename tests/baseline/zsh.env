BAT_CONFIG_PATH=~/.dotfiles/config/bat/config
BUN_INSTALL=~/.bun
DOTFILES_DIR=~/.dotfiles
DOTFILES_SHELL=zsh
EDITOR=nvim
FZF_DEFAULT_OPTS=--color=fg:#cdd6f4,bg:#1e1e2e,hl:#f38ba8,fg+:#cdd6f4,bg+:#313244,hl+:#f38ba8,info:#89b4fa,prompt:#cba6f7,pointer:#f5c2e7,marker:#a6e3a1,spinner:#f5c2e7,header:#89b4fa,border:#585b70
HISTFILE=~/.local/state/zsh/history
HISTSIZE=50000
HOMEBREW_CELLAR=unset
HOMEBREW_PREFIX=unset
JAVA_HOME=/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home
LANG=en_US.UTF-8
LC_ALL=unset
LC_CTYPE=en_US.UTF-8
NVM_DIR=~/.nvm
PAGER=less
RIPGREP_CONFIG_PATH=~/.dotfiles/config/ripgrep/ripgrep.conf
SAVEHIST=50000
VISUAL=nvim
XDG_CACHE_HOME=~/.cache
XDG_CONFIG_HOME=~/.config
XDG_DATA_HOME=~/.local/share
XDG_STATE_HOME=~/.local/state
cmd_brew=/opt/homebrew/bin/brew
cmd_git=/usr/bin/git
cmd_java=/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home/bin/java
cmd_launchctl=~/.local/bin/launchctl
cmd_node=/opt/homebrew/opt/node@24/bin/node
cmd_nvim=~/.local/bin/nvim
cmd_starship=/opt/homebrew/bin/starship
cmd_zoxide=/opt/homebrew/bin/zoxide
